# ══════════════════════════════════════════════════════════════
# Mini-NotebookLM 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# ══════════════════════════════════════════════════════════════

# ── MinerU 在线 API（文档解析，必填）────────────────────────
# 申请地址：https://mineru.net
MINERU_API_KEY=your_mineru_api_key_here


# ── 阿里云百炼 DashScope（嵌入 / 重排序 / VLM，必填）────────
# 申请地址：https://bailian.console.aliyun.com
# 用途：text-embedding-v4（嵌入）、qwen3-rerank（重排序）、VLM_MODEL（图片/表格富化）
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_dashscope_api_key_here


# ── QA 问答模型（可选，支持多 Provider）─────────────────────
# 不填时自动使用 DashScope；填写后切换到指定 Provider
#
# 选项 A：继续使用 DashScope（默认，无需填写下面任何内容）
#   QA 模型由 config.py 的 qa_model 默认值控制（当前：qwen-plus）
#
# 选项 B：切换到 DeepSeek
# QA_BASE_URL=https://api.deepseek.com/v1
# QA_API_KEY=sk-xxxxxxxxxxxxxxxx
# QA_MODEL=deepseek-chat
# QA_ENABLE_THINKING=false
#
# 选项 C：切换到 DeepSeek 思维链模型
# QA_BASE_URL=https://api.deepseek.com/v1
# QA_API_KEY=sk-xxxxxxxxxxxxxxxx
# QA_MODEL=deepseek-reasoner
# QA_ENABLE_THINKING=false   # reasoner 自动返回思维链，无需此参数
#
# 选项 D：切换到 OpenAI
# QA_BASE_URL=https://api.openai.com/v1
# QA_API_KEY=sk-xxxxxxxxxxxxxxxx
# QA_MODEL=gpt-4o
#
# 选项 E：切换到月之暗面 Moonshot
# QA_BASE_URL=https://api.moonshot.cn/v1
# QA_API_KEY=sk-xxxxxxxxxxxxxxxx
# QA_MODEL=moonshot-v1-8k


# ── VLM 模型（图片描述 / 表格摘要，可选覆盖）───────────────
# 默认：qwen-vl-plus（DashScope，需要 ALIBABA_CLOUD_ACCESS_KEY_SECRET）
# VLM_MODEL=qwen-vl-plus


# ── 调试模式 ─────────────────────────────────────────────────
# DEBUG=true
